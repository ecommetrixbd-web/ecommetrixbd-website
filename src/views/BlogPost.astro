---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PostCard from '../components/PostCard.astro';
import AuditBox from '../components/AuditBox.astro';
import { render } from 'astro:content';
import { readMinutes } from '../data/blog';
import { getLang, formatDateLang, minRead } from '../i18n';
const lang = getLang(Astro);

const { post, posts } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const related = posts.filter((p) => p.id !== post.id && p.data.category === d.category)
  .concat(posts.filter((p) => p.id !== post.id && p.data.category !== d.category)).slice(0, 3);
---
<Base title={`${d.title} | Ecommetrix Blog`} description={d.description}>
  <PageHeader eyebrow={d.category} title={d.title} lead={d.description}>
    <p class="post-meta">{d.author} · {formatDateLang(d.date, lang)} · {minRead(readMinutes(post.body), lang)}</p>
    <a class="back-link" href="/blog">← All posts</a>
  </PageHeader>
  <section class="section">
    <div class="wrap">
      {d.cover && <img class="post-cover" src={d.cover} alt="" />}
      <div class="prose"><Content /></div>
      <div class="prose-wide" style="margin-top:var(--s5)"><AuditBox /></div>
    </div>
  </section>
  {related.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <h2 class="h2" style="font-size:clamp(1.6rem,3vw,2.2rem);margin-bottom:var(--s3)">More from the blog</h2>
        <div class="post-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>
