---
import '../styles/global.css';
import '../styles/additions.css';
import { site } from '../data/site';

const { title = `${site.name} | Performance Marketing Agency in Dhaka`, description = site.description } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Our Work' },
  { href: '/#about', label: 'About Us' },
  { href: '/#team', label: 'Team' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href));
const logoPaths = `<path d="M254 437.5 190.5 437 239.5 278 251 270.5 304 271.5ZM95 437.5 33 437.5 32.5 435 79.5 281 87 273.5 94 270.5 145 271.5ZM174 437.5 110.5 437 160.5 272 209 270.5 218.5 276 220.5 286Z"/><path class="arrowpart" d="M333 438.5 269.5 438 320.5 271 279 243.5 274.5 236 322.5 87 322 84.5 304.5 79 372 26.5 394.5 106 381 102.5 376.5 105 343.5 211 385 242.5 389.5 249 389.5 254Z"/>`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600&family=Instrument+Serif&display=swap">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="nav" id="nav">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <svg viewBox="30 24 368 418" aria-hidden="true" set:html={logoPaths}></svg>
      ECOMMETRIX
    </a>
    <nav aria-label="Main">
      <ul class="menu">
        {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn-primary nav-cta" href="/contact">Let's talk <span class="arr">↗</span></a>
    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu"><span></span></button>
  </div>
</header>
<div class="mobile-menu" id="mobileMenu" hidden>
  <ul>
    {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
  </ul>
  <a class="btn btn-light" href="/contact">Let's talk <span class="arr">↗</span></a>
  <div class="contact-mini"><span>{site.phone}</span><span>{site.email}</span><span>{site.addressShort}</span></div>
</div>

<main id="main">
  <slot />
</main>

<footer class="footer">
  <div class="wrap">
    <div class="f-top">
      <div>
        <a class="brand" href="/" style="color:var(--ivory)"><svg viewBox="30 24 368 418" aria-hidden="true" set:html={logoPaths}></svg>ECOMMETRIX</a>
        <p>Performance marketing, video production, websites and tracking. Based in {site.addressShort}.</p>
      </div>
      <div class="f-col"><h4>Explore</h4><ul><li><a href="/services">Services</a></li><li><a href="/work">Our Work</a></li><li><a href="/#about">About Us</a></li><li><a href="/#team">Team</a></li><li><a href="/blog">Blog</a></li><li><a href="/contact">Contact</a></li></ul></div>
      <div class="f-col"><h4>Services</h4><ul><li><a href="/services">Meta, Google &amp; TikTok Ads</a></li><li><a href="/services">Video &amp; Creative Production</a></li><li><a href="/services">Website Design</a></li><li><a href="/services">Server-Side Tracking</a></li></ul></div>
      <div class="f-col"><h4>Contact</h4><ul>
        <li><span>{site.phone}</span><button class="copy-btn" type="button" data-copy={`+${site.phoneRaw}`}>Copy</button></li>
        <li><span>{site.email}</span><button class="copy-btn" type="button" data-copy={site.email}>Copy</button></li>
        <li>{site.addressShort}, Bangladesh</li>
        <li><a href={site.facebook} target="_blank" rel="noopener">Facebook ↗</a></li>
      </ul></div>
    </div>
    <div class="f-bottom"><span>© <span id="yr">2026</span> {site.name}. All rights reserved.</span><span>{site.tagline}</span></div>
  </div>
</footer>

<a class="wa" href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z"/></svg>
  <span>WhatsApp us</span>
</a>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
  <div class="modal-box">
    <div class="modal-stage" id="modal-stage">
      <div id="modal-empty">
        <span class="ph">Video coming soon</span>
        <h3 id="modal-title">Video</h3>
        <p>This video has not been added yet.</p>
      </div>
    </div>
    <div class="modal-bar"><span id="modal-cat">Category</span><button class="modal-close" id="modal-close" type="button" aria-label="Close video">×</button></div>
  </div>
</div>

<script is:inline src="/js/main.js" defer></script>
</body>
</html>
