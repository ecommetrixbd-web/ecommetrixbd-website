---
import PostCard from './PostCard.astro';
import { getPosts } from '../data/blog';
const posts = (await getPosts()).slice(0, 3);
---
{posts.length > 0 && (
<section class="section" id="blog" aria-labelledby="blog-title" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Blog</span>
        <h2 class="h2" id="blog-title">Notes from our work.</h2>
      </div>
      <p class="lead">Practical tips on ads, tracking and content, written from the projects we run every day.</p>
    </div>
    <div class="post-grid">{posts.map((p) => <PostCard post={p} />)}</div>
    <div class="center"><a class="btn btn-primary" href="/blog">Read all posts <span class="arr">→</span></a></div>
  </div>
</section>
)}
