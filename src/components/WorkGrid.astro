---
import { work, workTabs } from '../data/work';
import TrackIntro from './TrackIntro.astro';
const { limit = 0, showHead = true } = Astro.props;
---
<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    {showHead && (
      <div class="sec-head">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="h2" id="work-title">Ads, tracking and results.</h2>
        </div>
        <p class="lead">A few recent projects. Open any card for the full story, or see everything on the Our Work page.</p>
      </div>
    )}
    <div class="tabs" role="tablist" aria-label="Work type">
      {workTabs.map((t, i) => (
        <button class="tab" role="tab" id={`tab-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`p-${t.id}`} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
      ))}
    </div>
    {workTabs.map((t, i) => {
      const items = work.filter((w) => w.category === t.id);
      const shown = limit ? items.slice(0, limit) : items;
      return (
        <div class="panel" role="tabpanel" id={`p-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
          {t.id === 'tracking' && <TrackIntro />}
          <div class="cards3">
            {shown.map((w) => (
              <article class="wcard wlink">
                <div class="wthumb">
                  {w.image ? <img src={w.image} alt="" loading="lazy" decoding="async" /> : <span class="ph">Add image</span>}
                </div>
                <div class="stack">{w.tags.map((tag) => <span>{tag}</span>)}</div>
                <h3>{w.title}</h3>
                <p>{w.summary}</p>
                <a class="link" href={`/work/${w.slug}`}>Details <span class="arr">→</span><span class="sr">: {w.title}</span></a>
              </article>
            ))}
          </div>
        </div>
      );
    })}
    {limit > 0 && <div class="center" style="margin-top:var(--s4)"><a class="btn btn-primary" href="/work">See all work <span class="arr">→</span></a></div>}
  </div>
</section>
