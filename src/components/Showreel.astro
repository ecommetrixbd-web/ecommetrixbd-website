---
import { videos } from '../data/site';
const { full = false } = Astro.props;

const ytId = (u = '') => (u.match(/(?:youtu\.be\/|v=|shorts\/|embed\/)([\w-]{11})/) || [])[1];
const thumbOf = (v: { thumbnail?: string; video_url?: string }) =>
  v.thumbnail || (ytId(v.video_url) ? `https://img.youtube.com/vi/${ytId(v.video_url)}/hqdefault.jpg` : '');
const srcOf = (v: { video_file?: string; video_url?: string }) => v.video_file || v.video_url || '';

const reel = videos.showreel;
const list = full ? videos.items : videos.items.filter((v) => v.on_homepage);
const fmtLabel: Record<string, string> = { wide: '16:9', tall: '9:16', square: '4:5' };
---
<section class="section dark video" id="showreel" aria-labelledby="video-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">Video portfolio</span>
        <h2 class="h2" id="video-title">Videos we have made for our clients.</h2>
      </div>
      <p class="lead">Brand films, OVCs, product videos and reels. Planned, shot and edited by our own team, and cut for every ad placement.</p>
    </div>

    <button class="reel" type="button" data-video={reel.title} data-cat="Showreel" data-src={srcOf(reel)} aria-label={`Play ${reel.title}`}>
      <span class="poster" aria-hidden="true">
        {thumbOf(reel)
          ? <img src={thumbOf(reel)} alt="" />
          : <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
              <defs><radialGradient id="rp" cx="70%" cy="35%" r="80%"><stop offset="0" stop-color="#7A2234"/><stop offset=".5" stop-color="#2A0F17"/><stop offset="1" stop-color="#0E0507"/></radialGradient></defs>
              <rect width="1600" height="900" fill="url(#rp)"/>
              <g fill="none" stroke="#B8955A" stroke-opacity=".18"><circle cx="1150" cy="330" r="220"/><circle cx="1150" cy="330" r="330"/><circle cx="1150" cy="330" r="440"/></g>
              <text x="80" y="140" font-family="Manrope,system-ui,sans-serif" font-size="200" font-weight="800" fill="#F5F0E8" fill-opacity=".05" letter-spacing="-8">SHOWREEL</text>
            </svg>}
      </span>
      <span class="playbtn" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg></span>
      <span class="meta">
        <span><small>Featured showreel</small><h3>{reel.title}</h3></span>
        {!srcOf(reel) && <span class="ph">Add showreel video</span>}
      </span>
    </button>

    <div class={full ? 'vgrid full' : 'vgrid'}>
      {list.map((v, i) => (
        <button class={`vcard ${v.format}`} type="button" data-video={v.title} data-cat={v.category} data-src={srcOf(v)} data-tall={v.format === 'tall' ? '1' : undefined}>
          <span class="thumb">
            {thumbOf(v)
              ? <img src={thumbOf(v)} alt="" loading="lazy" decoding="async" />
              : <svg viewBox="0 0 160 160" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><linearGradient id={`vt${i}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5C1423"/><stop offset="1" stop-color="#140709"/></linearGradient></defs><rect width="160" height="160" fill={`url(#vt${i})`}/><circle cx="120" cy="40" r="34" fill="#B8955A" opacity=".14"/></svg>}
            <span class="playbtn"><svg viewBox="0 0 24 24"><path d="M6 4l14 8-14 8z"/></svg></span>
          </span>
          <span class="cap"><h4>{v.title}{!srcOf(v) && <span class="ph">Add video</span>}</h4><span class="cat">{v.category || fmtLabel[v.format]}</span></span>
        </button>
      ))}
    </div>
    {!full && <div class="center"><a class="btn btn-ghost" href="/work#showreel">View all videos <span class="arr">→</span></a></div>}
  </div>
</section>
