---
import { heroSlides, home } from '../data/site';
const total = heroSlides.length + 1;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow fade-in" style="--d:.05s">{home.eyebrow}</span>
        <h1 id="hero-title">
          <span class="ln"><span style="--i:0">{home.headline_line_1}</span></span>
          <span class="ln"><span style="--i:1">{home.headline_line_2}</span></span>
          <span class="ln"><span style="--i:2">{home.headline_line_3}</span></span>
        </h1>
        <p class="lead fade-in" style="--d:.65s">{home.intro}</p>
        <div class="hero-actions fade-in" style="--d:.8s">
          <a class="btn btn-light" href={home.button_1_link}>{home.button_1_text} <span class="arr">↗</span></a>
          <a class="btn btn-ghost" href={home.button_2_link}>{home.button_2_text} <span class="arr">→</span></a>
        </div>
        <p class="rotator fade-in" style="--d:.95s" aria-live="off"><span class="dot"></span>We do <b id="rot" data-words={JSON.stringify(home.rotator_words)}>{home.rotator_words[0] ?? ''}</b></p>
      </div>

      <div class="hero-carousel fade-in" style="--d:.3s" role="region" aria-roledescription="carousel" aria-label="Ecommetrix and our services">
        <div class="hc-track" id="hcTrack" tabindex="0">
          <div class="hc-slide hc-logo" role="group" aria-roledescription="slide" aria-label={`1 of ${total}: Ecommetrix`}>
            <div class="hero-mark" aria-hidden="true">
              <svg viewBox="0 0 400 400">
                <g class="rings">
                  <circle cx="200" cy="200" r="196"/>
                  <circle cx="200" cy="200" r="150" stroke-dasharray="2 8" class="spin"/>
                  <circle cx="200" cy="200" r="104"/>
                </g>
                <g transform="translate(92 96) scale(.52)">
                  <path class="bar" style="--i:0" d="M95 437.5 33 437.5 32.5 435 79.5 281 87 273.5 94 270.5 145 271.5Z"/>
                  <path class="bar" style="--i:1" d="M174 437.5 110.5 437 160.5 272 209 270.5 218.5 276 220.5 286Z"/>
                  <path class="bar" style="--i:2" d="M254 437.5 190.5 437 239.5 278 251 270.5 304 271.5Z"/>
                  <path class="arrowmark" d="M333 438.5 269.5 438 320.5 271 279 243.5 274.5 236 322.5 87 322 84.5 304.5 79 372 26.5 394.5 106 381 102.5 376.5 105 343.5 211 385 242.5 389.5 249 389.5 254Z"/>
                </g>
                <circle class="spark" cx="300" cy="70" r="3"/>
                <circle class="spark" cx="62" cy="150" r="2" style="animation-delay:-1.2s"/>
                <circle class="spark" cx="330" cy="300" r="2.5" style="animation-delay:-2.1s"/>
              </svg>
            </div>
          </div>
          {heroSlides.map((s, i) => (
            <figure class="hc-slide" role="group" aria-roledescription="slide" aria-label={`${i + 2} of ${total}: ${s.name}`}>
              {s.image
                ? <img src={s.image} alt={s.name} loading="lazy" decoding="async" />
                : <div class="hc-ph"><span class="ph">Add image</span></div>}
              <figcaption><span class="hc-num">{String(i + 1).padStart(2, '0')}</span>{s.name}</figcaption>
            </figure>
          ))}
        </div>
        <div class="hc-dots" role="group" aria-label="Choose slide">
          {Array.from({ length: total }).map((_, i) => (
            <button type="button" class="hc-dot" aria-label={`Show slide ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}></button>
          ))}
        </div>
      </div>
    </div>
    <div class="hero-foot fade-in" style="--d:1.1s">
      <span>{home.hero_strip}</span>
      <span class="scroll-cue"><i></i>Scroll down</span>
    </div>
  </div>
</section>
