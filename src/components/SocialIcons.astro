---
{icons.length > 0 && (
  <ul class="socials" aria-label="Follow us">
    {icons.map((i) => (
      <li><a class={`soc soc-${i.key}`} href={(s as Record<string, string>)[i.key]} target="_blank" rel="noopener" aria-label={i.label}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={i.path}></svg></a></li>
    ))}
  </ul>
)}
