---
import { home, faq } from '../data/site';
const t = home.testimonial ?? { quote: '', name: '', role: '' };
---
<section class="section tf" id="faq" aria-labelledby="faq-title">
  <div class="wrap tf-grid">
    <div>
      <span class="eyebrow">Client perspectives</span>
      <figure class="quote" style="margin-inline:0">
        <blockquote>{t.quote || "Approved client testimonial will appear here, in the client's own words."}</blockquote>
        <figcaption class="who"><b>{t.name || 'Client name'}</b><span>{t.role || 'Position, Company'}</span>{!t.quote && <span class="ph">Genuine testimonial pending</span>}</figcaption>
      </figure>
    </div>
    <div>
      <span class="eyebrow">FAQ</span>
      <h2 class="h2" id="faq-title" style="margin:var(--s3) 0 var(--s3);font-size:clamp(1.8rem,3vw,2.6rem)">Common questions</h2>
      <div class="faq">
        {faq.items.map((q, i) => (
          <div class="faq-item"><button class="faq-q" aria-expanded="false" id={`fq${i}`} aria-controls={`fa${i}`}>{q.question}<span class="pm" aria-hidden="true"></span></button><div class="faq-a" id={`fa${i}`} role="region" aria-labelledby={`fq${i}`}><div><p>{q.answer}</p></div></div></div>
        ))}
      </div>
    </div>
  </div>
</section>
