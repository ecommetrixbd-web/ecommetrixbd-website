---
import { team } from '../data/site';
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---
<section class="section team" id="team" aria-labelledby="team-title" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">The people behind the work</span>
        <h2 class="h2" id="team-title">The team you will work with.</h2>
      </div>
      <p class="lead">Marketers, video editors and designers, all working from our office in Aftabnagar, Dhaka.</p>
    </div>
    <div class="team-grid">
      {team.members.map((m, i) => (
        <figure class="member rv" style={`--i:${i % 5}`}>
          <div class="photo">
            {m.photo
              ? <img src={m.photo} alt={m.name} loading="lazy" decoding="async" />
              : <><svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Photo placeholder"><defs><radialGradient id={`pg${i}`} cx="50%" cy="30%" r="80%"><stop offset="0" stop-color="#5C1423"/><stop offset="1" stop-color="#1F0B10"/></radialGradient></defs><rect width="400" height="500" fill={`url(#pg${i})`}/><circle cx="200" cy="185" r="78" fill="#F5F0E8" fill-opacity=".07"/><path d="M60 500c8-104 66-160 140-160s132 56 140 160z" fill="#F5F0E8" fill-opacity=".07"/><text x="200" y="205" text-anchor="middle" font-family="Instrument Serif, Georgia, serif" font-size="58" fill="#B8955A">{initials(m.name)}</text></svg><span class="ph">Add photo</span></>}
            <span class="line"></span>
          </div>
          <figcaption><div><h3>{m.name}</h3><span class="role">{m.role}</span></div>{m.linkedin && <a class="in" href={m.linkedin} target="_blank" rel="noopener" aria-label={`${m.name} on LinkedIn`}>in</a>}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
