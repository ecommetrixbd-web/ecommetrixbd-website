---
import { home } from '../data/site';
const logos = home.client_logos ?? [];
---
<section class="trust" aria-label="Clients">
  <div class="wrap">
    <p>Trusted by growing brands{!logos.length && <><br /><span class="ph">Real logos pending</span></>}</p>
    <div class="marquee">
      <div class="marquee-track" id="marquee">
        {logos.length
          ? logos.map((l) => <span class="logo-img">{l.image ? <img src={l.image} alt={l.name} loading="lazy" decoding="async" /> : l.name}</span>)
          : [1, 2, 3, 4, 5, 6].map((n) => <span class="logo-ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 15l5-5 4 4 3-3 6 6"/></svg>Client logo 0{n}</span>)}
      </div>
    </div>
  </div>
</section>
