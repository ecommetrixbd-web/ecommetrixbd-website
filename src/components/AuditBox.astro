---
import { site } from '../data/site';
---
<aside class="audit-box" aria-label="Free ad audit">
  <div>
    <span class="eyebrow" style="color:var(--gold)">Free ad audit</span>
    <h2>Not sure where your ad money is going?</h2>
    <p>Send us your page or ad account. We will check it and tell you what to fix, free and with no obligation.</p>
  </div>
  <div class="audit-actions">
    <a class="btn btn-light" href="/contact">Get a free audit <span class="arr">↗</span></a>
    <a class="btn btn-ghost" href={`https://wa.me/${site.phoneRaw}`} target="_blank" rel="noopener">WhatsApp us <span class="arr">→</span></a>
  </div>
</aside>
