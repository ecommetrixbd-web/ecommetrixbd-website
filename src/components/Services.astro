            <g class="a-fade" style="--i:1"><text x="160" y="104" font-family="Instrument Serif, Georgia, serif" font-size="64" fill="#F5F0E8">Aa</text><rect x="160" y="116" width="70" height="4" rx="2" fill="#5A4A53"/><rect x="160" y="125" width="46" height="4" rx="2" fill="#3E3038"/></g>
