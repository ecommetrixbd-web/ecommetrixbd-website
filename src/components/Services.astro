          <div class="svc-video" set:html={videoTag}></div>
          <span class="svc-rec" aria-hidden="true"><i></i>REC</span>
        </div>
        <div class="body">
          <span class="num">04 / Creative</span>
          <h3>Video &amp; Creative Production</h3>
          <p>OVCs, product films and social video, shot and edited by our own team and cut for every ad placement.</p>
          <ul class="caps"><li>Concept &amp; script</li><li>Shoot &amp; edit</li><li>9:16 · 4:5 · 16:9 cuts</li></ul>
          <a class="link" href="/work#showreel">Watch our work <span class="arr">→</span></a>
        </div>
      </article>

      <!-- 05 Website -->
      <article class="svc">
        <div class="art" aria-hidden="true">
