---
import { site } from '../data/site';
const { swipe = false, showHead = true } = Astro.props;
const v = site.creativeVideo;
const videoTag = v.src ? `<video muted loop playsinline preload="none" ${v.poster ? `poster="${v.poster}"` : ''} aria-label="Sample of our video work"><source src="${v.src}" type="video/mp4"></video>` : '';
---
<section class="section services" id="services" aria-labelledby="svc-title" style="padding-top:0">
  <div class="wrap">
    {showHead && (<div class="sec-head">
      <div>
        <span class="eyebrow">What we do</span>
        <h2 class="h2" id="svc-title">Nine services under one roof.</h2>
      </div>
      <p class="lead">Start with one service or hand us the whole job. You deal with the same team either way.</p>
    </div>)}

    <div class={swipe ? "bento swipe" : "bento"}>

      <!-- 01 Meta Ads -->
      <article class="svc w3">
        <div class="art" aria-hidden="true">
          <svg viewBox="0 0 400 250">
            <defs>
              <linearGradient id="mg1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4F7BFF"/><stop offset="1" stop-color="#7A4DFF"/></linearGradient>
              <linearGradient id="mg2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3B5BDB"/><stop offset="1" stop-color="#A06BFF"/></linearGradient>
              <linearGradient id="mg3" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#6D5BFF"/><stop offset="1" stop-color="#C08BFF"/></linearGradient>
            </defs>
            <g class="a-fade" style="--i:0"><rect x="34" y="38" width="96" height="150" rx="8" fill="#22161C" stroke="#3A2A33"/><rect x="42" y="56" width="80" height="80" rx="4" fill="url(#mg1)"/><circle cx="48" cy="47" r="4" fill="#6F8BFF"/><rect x="56" y="44" width="40" height="5" rx="2.5" fill="#4A3A43"/><rect x="42" y="144" width="64" height="5" rx="2.5" fill="#5A4A53"/><rect x="42" y="154" width="44" height="5" rx="2.5" fill="#3E3038"/><rect x="42" y="168" width="80" height="12" rx="3" fill="#4F7BFF"/></g>
            <g class="a-fade hov" style="--i:1"><rect x="146" y="22" width="96" height="150" rx="8" fill="#22161C" stroke="#3A2A33"/><rect x="154" y="40" width="80" height="80" rx="4" fill="url(#mg2)"/><path d="M188 72l14 8-14 8z" fill="#fff" opacity=".9"/><circle cx="160" cy="31" r="4" fill="#9B7BFF"/><rect x="168" y="28" width="40" height="5" rx="2.5" fill="#4A3A43"/><rect x="154" y="128" width="64" height="5" rx="2.5" fill="#5A4A53"/><rect x="154" y="138" width="44" height="5" rx="2.5" fill="#3E3038"/><rect x="154" y="152" width="80" height="12" rx="3" fill="#7A4DFF"/></g>
            <g class="a-fade" style="--i:2"><rect x="258" y="38" width="96" height="150" rx="8" fill="#22161C" stroke="#3A2A33"/><rect x="266" y="56" width="80" height="80" rx="4" fill="url(#mg3)"/><circle cx="272" cy="47" r="4" fill="#B48BFF"/><rect x="280" y="44" width="40" height="5" rx="2.5" fill="#4A3A43"/><rect x="266" y="144" width="64" height="5" rx="2.5" fill="#5A4A53"/><rect x="266" y="154" width="44" height="5" rx="2.5" fill="#3E3038"/><rect x="266" y="168" width="80" height="12" rx="3" fill="#A06BFF"/></g>
            <g class="a-pop" style="--i:3"><circle cx="70" cy="218" r="16" fill="#4F7BFF" opacity=".55"/><circle cx="88" cy="218" r="16" fill="#7A4DFF" opacity=".55"/><circle cx="79" cy="204" r="16" fill="#C08BFF" opacity=".45"/></g>
            <path class="a-draw" style="--i:4;--len:260" d="M118 222 H200 L224 206 H330" fill="none" stroke="#8C7BFF" stroke-width="2" stroke-dasharray="4 5"/>
            <g class="a-pop" style="--i:5"><rect x="330" y="196" width="40" height="20" rx="10" fill="#7A4DFF"/><path d="M342 206l4 4 8-8" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/></g>
          </svg>
        </div>
        <div class="body">
          <span class="num">01 / Performance</span>
          <h3>Meta Ads</h3>
          <p>Facebook and Instagram campaigns that pair sharp creative with clean data, so budget goes where sales come from.</p>
          <ul class="caps"><li>Campaign strategy</li><li>Creative testing</li><li>Retargeting</li><li>CAPI-ready setup</li></ul>
          <a class="link" href="/contact">Learn more <span class="arr">→</span></a>
        </div>
      </article>

      <!-- 02 Google Ads -->
      <article class="svc w3">
        <div class="art" aria-hidden="true">
