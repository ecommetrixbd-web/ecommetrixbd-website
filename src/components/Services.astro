              <rect x="152" y="218" width="96" height="3" fill="#ffffff22"/><rect class="a-grow" style="--i:2;transform-origin:0 50%" x="152" y="218" width="58" height="3" fill="#25F4EE"/></g>
            <g class="float loop" style="--i:0"><circle cx="282" cy="78" r="14" fill="#FE2C55"/><path d="M282 85l-6-6a3.6 3.6 0 0 1 6-4 3.6 3.6 0 0 1 6 4z" fill="#fff"/></g>
            <g class="float loop" style="--i:1"><circle cx="306" cy="130" r="12" fill="#25F4EE"/><rect x="300" y="125" width="12" height="9" rx="2" fill="#0E0709"/></g>
            <g class="float loop" style="--i:2"><circle cx="280" cy="176" r="11" fill="#F5F0E8"/><path d="M276 176h8m-3-3 3 3-3 3" stroke="#0E0709" stroke-width="1.6" fill="none"/></g>
            <g class="a-fade" style="--i:3"><rect x="40" y="60" width="80" height="26" rx="5" fill="#1E1418" stroke="#3A2A33"/><rect x="48" y="70" width="32" height="6" rx="3" fill="#25F4EE"/><rect x="40" y="96" width="80" height="26" rx="5" fill="#1E1418" stroke="#3A2A33"/><rect x="48" y="106" width="50" height="6" rx="3" fill="#FE2C55"/><rect x="40" y="132" width="80" height="26" rx="5" fill="#1E1418" stroke="#3A2A33"/><rect x="48" y="142" width="40" height="6" rx="3" fill="#F5F0E8"/></g>
          </svg>
        </div>
        <div class="body">
