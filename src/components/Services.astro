            <rect x="40" y="24" width="250" height="18" rx="8" fill="#2A1F33"/><circle cx="52" cy="33" r="3" fill="#B9A6FF"/><circle cx="62" cy="33" r="3" fill="#8F7BEA"/><circle cx="72" cy="33" r="3" fill="#6B8BFF"/>
