            <g><line x1="44" y1="210" x2="356" y2="210" stroke="#3A2A33"/>
              <rect class="a-grow" style="--i:1" x="60" y="150" width="30" height="60" rx="3" fill="#4285F4"/>
              <rect class="a-grow" style="--i:2" x="110" y="128" width="30" height="82" rx="3" fill="#EA4335"/>
              <rect class="a-grow" style="--i:3" x="160" y="138" width="30" height="72" rx="3" fill="#FBBC04"/>
              <rect class="a-grow" style="--i:4" x="210" y="106" width="30" height="104" rx="3" fill="#34A853"/>
              <rect class="a-grow" style="--i:5" x="260" y="88" width="30" height="122" rx="3" fill="#4285F4"/>
              <rect class="a-grow" style="--i:6" x="310" y="74" width="30" height="136" rx="3" fill="#34A853"/>
            </g>
            <path class="a-draw" style="--i:3;--len:340" d="M75 140 L125 118 L175 124 L225 94 L275 76 L325 60" fill="none" stroke="#F5F0E8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <g class="a-pop hov" style="--i:7"><circle cx="325" cy="60" r="7" fill="#F5F0E8"/><circle cx="325" cy="60" r="13" fill="none" stroke="#F5F0E8" stroke-opacity=".35"/></g>
            <g class="a-pop" style="--i:8"><rect x="44" y="72" width="88" height="26" rx="13" fill="#2A1C22" stroke="#34A853"/><circle cx="60" cy="85" r="4" fill="#34A853"/><rect x="70" y="82" width="50" height="6" rx="3" fill="#5A4A53"/></g>
