            <g class="a-fade" style="--i:5"><rect x="292" y="34" width="48" height="8" rx="2" fill="#3B1E14"/><rect x="292" y="34" width="12" height="8" fill="#5C1423"/><rect x="304" y="34" width="12" height="8" fill="#C2543A"/><rect x="316" y="34" width="12" height="8" fill="#E8A25A"/><rect x="328" y="34" width="12" height="8" fill="#F3DDB8"/></g>
