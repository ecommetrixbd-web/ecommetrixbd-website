---
import { services } from '../data/site';
import { serviceArt } from './serviceArt';
const { swipe = false, showHead = true } = Astro.props;
const sizeClass: Record<string, string> = { normal: 'svc', wide: 'svc w3', full: 'svc w6' };
const v = services.creative_video;
const poster = services.creative_video_poster;
const videoTag = v
  ? `<video muted loop playsinline preload="none" ${poster ? `poster="${poster}"` : ''} aria-label="Sample of our video work"><source src="${v}" type="video/mp4"></video>`
  : '';
const fallbackArt = '<svg viewBox="0 0 400 250"><rect width="400" height="250" fill="#26131A"/><circle cx="300" cy="70" r="60" fill="#B8955A" opacity=".12"/></svg>';
---
<section class="section services" id="services" aria-labelledby="svc-title" style="padding-top:0">
  <div class="wrap">
    {showHead && (<div class="sec-head">
      <div>
        <span class="eyebrow">What we do</span>
        <h2 class="h2" id="svc-title">{services.items.length} services under one roof.</h2>
      </div>
      <p class="lead">Start with one service or hand us the whole job. You deal with the same team either way.</p>
    </div>)}

    <div class={swipe ? 'bento swipe' : 'bento'}>
      {services.items.map((s) => (
        <article class={sizeClass[s.size] ?? 'svc'}>
          <div class="art" aria-hidden="true">
            <Fragment set:html={serviceArt[s.art] ?? fallbackArt} />
            {s.art === 'video' && videoTag && <div class="svc-video" set:html={videoTag}></div>}
            {s.art === 'video' && videoTag && <span class="svc-rec" aria-hidden="true"><i></i>REC</span>}
          </div>
          <div class="body">
            <span class="num">{s.label}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.bullets?.length > 0 && <ul class="caps">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
            {s.link_text && <a class="link" href={s.link_url || '/contact'}>{s.link_text} <span class="arr">→</span></a>}
          </div>
        </article>
      ))}
    </div>
    {swipe && <p class="swipe-hint" aria-hidden="true">Swipe to see all services →</p>}
  </div>
</section>
