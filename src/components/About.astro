---
import { home } from '../data/site';
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about-grid">
      <div>
        <span class="eyebrow">How we work</span>
        <h2 class="h2" id="about-title" style="margin-top:var(--s3)">Ads, content and data, handled by one team.</h2>
        <p class="lead">Most brands hire one person for ads, another for videos and someone else for the website. Nobody looks at the full picture. We do all of it in one place, so the ad, the video and the landing page are planned together and measured with the same numbers.</p>
      </div>
      <div class="pillars">
        <div class="pillar rv"><span class="k">i.</span><h3>Performance</h3><p>Google, Meta and TikTok campaigns run against business goals, not vanity metrics.</p></div>
        <div class="pillar rv" style="--i:1"><span class="k">ii.</span><h3>Creative</h3><p>Video, design and content made in-house and built to perform in ads.</p></div>
        <div class="pillar rv" style="--i:2"><span class="k">iii.</span><h3>Technology</h3><p>Websites, landing pages and integrations that turn attention into orders.</p></div>
        <div class="pillar rv" style="--i:3"><span class="k">iv.</span><h3>Data</h3><p>Server-side tracking and clean reporting, so decisions rest on reliable numbers.</p></div>
      </div>
    </div>
    <div class="stats">
      {home.stats.map((st, i) => (
        <div class="stat rv" style={`--i:${i}`}><b>{st.value || '—'}</b><span>{st.label}</span>{!st.value && <span class="ph">Add verified number</span>}</div>
      ))}
    </div>
  </div>
</section>
